{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/starcad-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  
  "ConnectionStrings": {
    "StarCADContext": "Server=127.0.0.1,1433;Database=StarCAD;User Id=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True"
  },
  
  "JWTAuth": {
    "ValidIssuerURL": "http://localhost:5193/",
    "ValidAudienceURL": "http://localhost:5193/",
    "SecretKey": "",
    "Expire": "480"
  },
  
  "MinioSettings": {
    "Endpoint": "localhost:29000",
    "PublicEndpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "starcad-drawings",
    "WithSSL": false,
    "PresignExpirySeconds": 3600
  },

  "Encryption": {
    "_comment": "KVKK: TC kimlik AES-GCM ile şifrelenir, HMAC ile benzersizlik. Base64 32-byte anahtarlar. Boş bırakıldı: değerler docker-compose env / user-secrets / prod env ile verilir (secret repoya girmesin).",
    "Key": "",
    "HmacKey": ""
  },

  "RedisSettings": {
    "Endpoint": "localhost:6379"
  },

  "ElasticSettings": {
    "Endpoint": "http://localhost:9200",
    "MaxSearchResults": 1000
  }
}
